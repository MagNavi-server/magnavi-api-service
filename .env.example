# 복사한 .env에 개발 전용 비밀번호를 직접 설정한다. 빈 값이면 Compose가 실행을 거절한다.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MAGNAVI_MYSQL_PORT=13306

# openssl rand -base64 32 로 만든 개발 전용 키를 설정한다. 실제 키는 Git에 올리지 않는다.
JWT_SECRET_BASE64=

# NAVER API HUB의 검색용 키다. 지도 표시용 키와 구분하고 실제 값은 Git에 올리지 않는다.
NAVER_SEARCH_ENABLED=false
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# 실제 mapx/mapy가 도 단위면 DEGREES, 도에 10^7을 곱한 정수면 E7로 명시한다.
NAVER_SEARCH_COORDINATE_FORMAT=UNCONFIRMED
