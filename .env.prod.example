# 이 파일은 설명용 예시입니다. 실제 값은 복사한 .env.prod에만 넣습니다.
# .env.prod는 Git과 Docker 빌드 대상에서 제외됩니다. 채팅·로그에도 값을 올리지 마세요.

# ECR에 올려 검증한 Spring 이미지의 전체 주소를 지정합니다. 배포에는 digest를 권장합니다.
# 형식: ACCOUNT_ID.dkr.ecr.ap-northeast-2.amazonaws.com/magnavi-api@sha256:DIGEST
# ACCOUNT_ID와 DIGEST는 설명용 표시입니다. docs/DEPLOYMENT.md의 조회 결과를 넣습니다.
SPRING_IMAGE=

# MySQL 관리자(root) 계정 하나를 사용합니다. 복사한 .env.prod에 원하는 비밀번호를 직접 입력합니다.
# Compose에서 이 값을 MySQL이 요구하는 MYSQL_ROOT_PASSWORD로 전달합니다.
MYSQL_PASSWORD=

# 로그인 토큰에 서명할 키입니다. openssl rand -base64 32로 한 번 생성합니다.
# 재배포 때도 유지해야 기존 토큰이 계속 유효합니다. 실제 값을 Git에 넣지 마세요.
JWT_SECRET_BASE64=

# EC2 내부에서 Spring 상태를 확인할 포트입니다. 인터넷에는 게시하지 않습니다.
SPRING_HTTP_PORT=8080
